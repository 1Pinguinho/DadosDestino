<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DadosDestino</AssemblyName>
    <RootNamespace>RolagemRpg</RootNamespace>
    <Product>Dados &amp; Destino</Product>
    <Version>1.1.0</Version>
    <!-- O pacote do WebView2 traz uma referência de WPF que este app não usa. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- Não é um site do IIS: dispensa o web.config. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- O site vai dentro do .exe, então o app é um arquivo só. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
    <EmbeddedResource Include="Launcher\launcher.html" LogicalName="launcher.html" />
    <!-- Arquivos dos testes em Node não fazem parte do app. -->
    <Content Remove="package.json;tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
</Project>
