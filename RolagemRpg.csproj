<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DadosDestino</AssemblyName>
    <RootNamespace>RolagemRpg</RootNamespace>
    <Product>Dados &amp; Destino</Product>
    <Version>1.7.0</Version>
    <!-- O pacote do WebView2 traz uma referÃªncia de WPF que este app nÃ£o usa. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- NÃ£o Ã© um site do IIS: dispensa o web.config. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!--
    O app sai em pastas, ao lado do DadosDestino.exe:
      site/      a mesa (HTML, CSS, JS)      launcher/  a tela inicial
      docs/      como o app funciona        config/ e dados/ sÃ£o criadas quando o app abre
  -->
  <ItemGroup>
    <Content Remove="site\**;launcher\**;docs\**" />
    <None Remove="site\**;launcher\**;docs\**" />
    <None Include="site\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="launcher\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="docs\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="LEIA-ME.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Arquivos dos testes em Node nÃ£o fazem parte do app. -->
    <Content Remove="package.json;tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
</Project>
